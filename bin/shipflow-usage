#!/usr/bin/env node
// shipflow-usage — Claude subscription usage gate for the ShipFlow loop.
//
// The loop must not start a tick once the account's 5-hour or weekly usage is
// at or above a threshold (default 90%). Claude Code exposes those numbers to
// exactly one place a script can reach: the STATUSLINE command, which receives
// a JSON document on stdin that includes
//
//   "rate_limits": { "five_hour": { "used_percentage", "resets_at" },
//                    "seven_day": { "used_percentage", "resets_at" },
//                    "spend_limit": { ... } }            // gateway deployments
//
// (present for subscribers after the first API response, each window only
// while its resets_at has not passed). Documented schema:
// https://code.claude.com/docs/en/statusline — the only official, scriptable
// source of these numbers. So this script has two halves:
//
//   shipflow-usage record                statusline sink: reads that JSON on
//                                        stdin, writes ~/.shipflow/usage.json,
//                                        prints a compact "5h 42% · 7d 12%"
//   shipflow-usage check [--max N]       the gate the loop runs at tick start
//         [--max-age SECONDS] [--text]   exit 0 = below max (or no limits apply)
//                                        exit 3 = at/over max → do not start
//                                        exit 2 = unknown (no/stale snapshot)
//                                        exit 1 = bad --max / --max-age
//   shipflow-usage install-statusline    adds the sink to Claude Code's
//         [--dry-run]                    settings.json when no statusLine is
//                                        configured (exit 4 when one is — chain
//                                        it instead, never overwritten)
//   shipflow-usage limit-reset           spend Claude Code's once-a-week
//         [--max N] [--reset-at N]       "/limit-reset" to clear the 5-hour
//         [--dry-run] [--text]           window so a paused loop can resume.
//                                        Only when the window is at/over the
//                                        reset floor (--reset-at, default 99%),
//                                        never merely at/over --max
//                                        (exit 0 = reset, 5 = skipped,
//                                        2 = attempted, outcome unclear)
//   shipflow-usage show                  print the snapshot
//
// Env: SHIPFLOW_STATE_DIR (default ~/.shipflow) · SHIPFLOW_LOOP_USAGE_MAX
// (default for --max, 90) · SHIPFLOW_LOOP_RESET_AT (default for --reset-at,
// 99) · SHIPFLOW_USAGE_MAX_AGE (default for --max-age, 3600) ·
// CLAUDE_CONFIG_DIR (default ~/.claude, for install-statusline) ·
// SHIPFLOW_CLAUDE_BIN (default `claude` on PATH, for limit-reset).
//
// ── OpenAI Codex CLI (`--source codex` / SHIPFLOW_USAGE_SOURCE=codex) ─────────
// Codex has no statusline, but `codex app-server` answers
// `account/rateLimits/read` — the numbers its `/usage` screen shows (usedPercent,
// windowDurationMins, resetsAt per window, plus the account's rate-limit RESET
// CREDITS) — and `account/rateLimitResetCredit/consume`, the "Full reset" that
// `/usage` offers. So under Codex:
//
//   check          reads the limits LIVE (no sink, never stale) and snapshots
//                  them to ~/.shipflow/usage-codex.json; same exit codes
//   limit-reset    spends one reset credit through the app server. A Codex
//                  reset clears EVERY window, so the 5-hour-only and
//                  weekly-blocker rails do not apply; what remains: only at/over
//                  the reset floor (--reset-at, default 99%), only with a credit
//                  available, one attempt per cooldown, SHIPFLOW_LOOP_LIMIT_RESET=off
//   install-statusline   not needed — prints so, exit 0
//
// Source: --source codex|claude → $SHIPFLOW_USAGE_SOURCE → codex when the shell
// carries Codex's own env (CODEX_SANDBOX / CODEX_THREAD_ID, set inside `codex
// exec` and the TUI) → claude. CODEX_BIN (default `codex` on PATH).
//
// No dependencies beyond node (the plugin launcher already requires it).
"use strict";

const fs = require("fs");
const os = require("os");
const path = require("path");
const { spawn, spawnSync } = require("child_process");
const crypto = require("crypto");

const HOME = os.homedir();
const STATE_DIR = process.env.SHIPFLOW_STATE_DIR || path.join(HOME, ".shipflow");
const CLAUDE_SNAPSHOT = path.join(STATE_DIR, "usage.json");
const CODEX_SNAPSHOT = path.join(STATE_DIR, "usage-codex.json");
// The snapshot every command reads/writes; main() points it at the source's
// file (Claude statusline sink vs. Codex live read) before dispatching.
let SNAPSHOT = CLAUDE_SNAPSHOT;
const WINDOW_LABEL = { five_hour: "5h", seven_day: "7d", spend_limit: "spend" };
const WINDOW_ORDER = ["five_hour", "seven_day", "spend_limit"];

// `/limit-reset` is allowed once a week, so a settled outcome (reset, already
// spent, unsupported CLI) parks the attempt for a week. A transient failure
// retries after an hour, not every 15-minute tick.
const RESET_COOLDOWN_SECONDS = 7 * 24 * 3600;
const RESET_RETRY_SECONDS = 3600;
// The gate stops ticks at --max (90%) so a dispatched worker never runs into
// the limit, but a reset is a scarce resource: a window at 90% still has room
// and resets on its own within hours. Spend the reset only once the window is
// effectively exhausted (operator requirement, 2026-09-09: "only at 99%").
const RESET_FLOOR_DEFAULT = 99;

function nowSeconds() {
  return Math.floor(Date.now() / 1000);
}

function readJSON(file) {
  try {
    const parsed = JSON.parse(fs.readFileSync(file, "utf8"));
    // Arrays/numbers/strings are valid JSON but not a snapshot; treat like
    // corrupt so `check` is unknown (exit 2), not not-applicable (exit 0).
    return parsed && typeof parsed === "object" && !Array.isArray(parsed) ? parsed : null;
  } catch {
    // Missing, unreadable, or corrupt: treat as no snapshot so `check` can
    // return unknown (exit 2) and `record` can overwrite the file.
    return null;
  }
}

function writeJSONAtomic(file, value) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  let priorMode = null;
  try {
    priorMode = fs.statSync(file).mode & 0o777;
  } catch {
    // new file — umask applies
  }
  const tmp = `${file}.${process.pid}.tmp`;
  fs.writeFileSync(tmp, JSON.stringify(value, null, 2) + "\n");
  if (priorMode !== null) fs.chmodSync(tmp, priorMode);
  fs.renameSync(tmp, file);
}

function readStdin() {
  try {
    return fs.readFileSync(0, "utf8");
  } catch {
    return "";
  }
}

// Windows whose reset time has not passed. A window that vanished from the
// statusline because its resets_at passed is a reset, not unknown.
function liveWindows(windows, now) {
  const out = {};
  for (const key of Object.keys(windows || {})) {
    const w = windows[key];
    if (!w || typeof w.used_percentage !== "number" || !Number.isFinite(w.used_percentage)) continue;
    if (typeof w.resets_at === "number" && w.resets_at <= now) continue;
    out[key] = { used_percentage: w.used_percentage, resets_at: typeof w.resets_at === "number" ? w.resets_at : null };
  }
  return out;
}

function windowLabel(key) {
  return WINDOW_LABEL[key] || key;
}

function orderedWindowKeys(windows) {
  const rank = (k) => {
    const i = WINDOW_ORDER.indexOf(k);
    return i === -1 ? WINDOW_ORDER.length : i;
  };
  return Object.keys(windows || {}).sort((a, b) => rank(a) - rank(b) || a.localeCompare(b));
}

function formatWindows(windows) {
  const parts = [];
  for (const key of orderedWindowKeys(windows)) {
    const w = windows[key];
    if (!w) continue;
    parts.push(`${windowLabel(key)} ${Math.round(w.used_percentage)}%`);
  }
  return parts.join(" · ");
}

function envNum(v) {
  return typeof v === "string" && v.trim() ? v : undefined;
}

function formatResetsAt(epochSeconds) {
  if (typeof epochSeconds !== "number") return "";
  const d = new Date(epochSeconds * 1000);
  return d.toLocaleTimeString(undefined, { hour: "2-digit", minute: "2-digit" });
}

function parseArgs(argv) {
  const opts = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--max" || a === "--max-age" || a === "--reset-at") {
      opts[a.slice(2)] = argv[++i];
    } else if (a.startsWith("--max=")) {
      opts.max = a.slice(6);
    } else if (a.startsWith("--max-age=")) {
      opts["max-age"] = a.slice(10);
    } else if (a.startsWith("--reset-at=")) {
      opts["reset-at"] = a.slice(11);
    } else if (a === "--source") {
      opts.source = argv[++i];
    } else if (a.startsWith("--source=")) {
      opts.source = a.slice(9);
    } else if (a === "--text" || a === "--json" || a === "--dry-run") {
      opts[a.slice(2)] = true;
    } else {
      opts._.push(a);
    }
  }
  return opts;
}

// ── record ──────────────────────────────────────────────────────────────────

function cmdRecord() {
  const raw = readStdin();
  let input = null;
  try {
    input = raw.trim() ? JSON.parse(raw) : null;
  } catch {
    input = null;
  }
  const now = nowSeconds();
  const prev = readJSON(SNAPSHOT) || {};
  // A window with no resets_at can never expire, so never carry it forward.
  const carried = {};
  for (const [key, w] of Object.entries(liveWindows(prev.windows, now))) {
    if (typeof w.resets_at === "number") carried[key] = w;
  }
  const fresh = input && input.rate_limits && typeof input.rate_limits === "object" ? liveWindows(input.rate_limits, now) : {};
  const sawLimits = Object.keys(fresh).length > 0;
  const windows = Object.assign({}, carried, fresh);

  const snapshot = {
    // recorded_at = the last time the statusline actually reported limits;
    // observed_at = the last time the sink ran at all (limits or not).
    recorded_at: sawLimits ? new Date(now * 1000).toISOString() : prev.recorded_at || null,
    observed_at: new Date(now * 1000).toISOString(),
    source: "claude-code-statusline",
    // Subscribers get rate_limits after the first API response; an account
    // that never reports any (API key, no limits) stays has_limits=false.
    has_limits: sawLimits || Boolean(prev.has_limits),
    windows,
  };
  if (input && input.model && typeof input.model === "object" && input.model.display_name) {
    snapshot.model = input.model.display_name;
  }
  // The sink rewrites the file on every statusline refresh; the limit-reset
  // ledger has to survive that or the cooldown resets with it.
  if (prev.limit_reset && typeof prev.limit_reset === "object") {
    snapshot.limit_reset = prev.limit_reset;
  }
  writeJSONAtomic(SNAPSHOT, snapshot);

  const line = formatWindows(windows);
  process.stdout.write(line ? `${line}\n` : "");
  return 0;
}

// ── check ───────────────────────────────────────────────────────────────────

function evaluate(snapshot, { max, maxAge, now }) {
  const result = { max, snapshot: SNAPSHOT, verdict: "unknown", ok: null, reason: "", windows: {}, worst: null, recorded_at: null, age_seconds: null, stale: false };
  if (!snapshot) {
    result.reason = "no usage snapshot — install the statusline sink (shipflow-usage install-statusline) and run one turn";
    return result;
  }
  const windows = liveWindows(snapshot.windows, now);
  for (const key of orderedWindowKeys(windows)) {
    const w = windows[key];
    if (!w) continue;
    result.windows[key] = Object.assign({}, w, {
      resets_in_minutes: typeof w.resets_at === "number" ? Math.max(0, Math.round((w.resets_at - now) / 60)) : null,
    });
    if (!result.worst || w.used_percentage > result.worst.used_percentage) {
      result.worst = { window: key, label: windowLabel(key), used_percentage: w.used_percentage, resets_at: w.resets_at };
    }
  }
  result.recorded_at = snapshot.recorded_at || null;
  const rec = snapshot.recorded_at ? Math.floor(Date.parse(snapshot.recorded_at) / 1000) : NaN;
  if (Number.isFinite(rec)) {
    result.age_seconds = Math.max(0, now - rec);
    result.stale = result.age_seconds > maxAge;
  } else {
    // Missing or unparseable timestamp: freshness cannot be proven → stale.
    result.stale = true;
  }

  if (!result.worst) {
    if (snapshot.has_limits && result.stale) {
      // Windows expired, but the sink has not run since — a new window may
      // already be filling and this snapshot cannot see it.
      result.verdict = "unknown";
      result.ok = null;
      result.reason = Number.isFinite(result.age_seconds)
        ? `all usage windows have reset, but the snapshot is ${Math.round(result.age_seconds / 60)} min old (max ${Math.round(maxAge / 60)})`
        : "all usage windows have reset, but the snapshot has no usable recorded_at";
    } else if (snapshot.has_limits) {
      // Every window it ever reported has reset; nothing is counting against
      // the account right now.
      result.verdict = "ok";
      result.ok = true;
      result.reason = "all usage windows have reset";
    } else {
      result.verdict = "not-applicable";
      result.ok = true;
      result.reason = "this account reports no subscription usage limits";
    }
    return result;
  }

  // Usage only grows until a window resets, so a stale reading is a lower
  // bound: at/over max stale is still over; below max stale proves nothing.
  if (result.worst.used_percentage >= max) {
    result.verdict = "over";
    result.ok = false;
    result.reason = `${result.worst.label} usage ${Math.round(result.worst.used_percentage)}% ≥ ${max}%` +
      (typeof result.worst.resets_at === "number" ? ` (resets ${formatResetsAt(result.worst.resets_at)})` : "");
    return result;
  }
  if (result.stale) {
    result.verdict = "unknown";
    result.ok = null;
    result.reason = Number.isFinite(result.age_seconds)
      ? `usage snapshot is ${Math.round(result.age_seconds / 60)} min old (max ${Math.round(maxAge / 60)}); last seen ${formatWindows(windows)}`
      : `usage snapshot has no usable recorded_at; last seen ${formatWindows(windows)}`;
    return result;
  }
  result.verdict = "ok";
  result.ok = true;
  result.reason = `${formatWindows(windows)} — below ${max}%`;
  return result;
}

// --max / --max-age, validated once for every gate command. null = bad input
// (already reported on stderr → exit 1).
function gateThresholds(opts) {
  const max = Number(opts.max ?? envNum(process.env.SHIPFLOW_LOOP_USAGE_MAX) ?? 90);
  const rawMaxAge = Number(opts["max-age"] ?? envNum(process.env.SHIPFLOW_USAGE_MAX_AGE) ?? 3600);
  if (!Number.isFinite(max) || max <= 0 || max > 100) {
    process.stderr.write(`shipflow-usage: --max must be a percentage in (0, 100], got ${JSON.stringify(opts.max)}\n`);
    return null;
  }
  if (opts["max-age"] !== undefined && (!Number.isFinite(rawMaxAge) || rawMaxAge <= 0)) {
    process.stderr.write(`shipflow-usage: --max-age must be a positive number of seconds, got ${JSON.stringify(opts["max-age"])}\n`);
    return null;
  }
  const maxAge = Number.isFinite(rawMaxAge) && rawMaxAge > 0 ? rawMaxAge : 3600;
  return { max, maxAge };
}

function emitCheck(result, opts) {
  if (opts.text) {
    const status = result.verdict === "over" ? "STOP" : result.verdict === "unknown" ? "UNKNOWN" : "OK";
    process.stdout.write(`usage ${status}: ${result.reason}\n`);
  } else {
    process.stdout.write(JSON.stringify(result) + "\n");
  }
  if (result.verdict === "over") return 3;
  if (result.verdict === "unknown") return 2;
  return 0;
}

function cmdCheck(opts) {
  const t = gateThresholds(opts);
  if (!t) return 1;
  const result = evaluate(readJSON(SNAPSHOT), { max: t.max, maxAge: t.maxAge, now: nowSeconds() });
  return emitCheck(result, opts);
}

// ── limit-reset ─────────────────────────────────────────────────────────────

// Claude Code 2.1.x ships an undocumented `/limit-reset` slash command that
// clears the 5-hour ("session") window immediately. It is allowed ONCE A WEEK
// and what it grants still counts against the weekly limit, so it is a scarce
// resource: only spend it when the 5-hour window is what stopped the loop and
// the weekly window still has room. Absent in 2.1.240, present in 2.1.252 and
// 2.1.260; undocumented, so every outcome that is not a recognized success is
// treated as "did not reset" and the loop stays paused.
//
// Built-in slash commands resolve in `claude -p` (verified: `/cost` and
// `/usage` print, `/status` answers "isn't available in this environment",
// an unknown command answers "Unknown command: …"), which is how a loop tick
// reaches one — the orchestrator cannot type into its own REPL.
const RESET_PATTERNS = [
  // Order matters: the refusals are checked before the success line so a
  // message that names both ("Weekly reset used … Session limit reset …")
  // is never read as a fresh reset.
  { outcome: "already-used", exit: 5, re: /weekly reset used|available again/i, settled: true },
  { outcome: "unavailable", exit: 5, re: /isn't available in this environment|is not available in this environment|unknown command/i, settled: true },
  { outcome: "error", exit: 2, re: /couldn't reset|could not reset|try again in a moment/i, settled: false },
  { outcome: "reset", exit: 0, re: /session limit (?:has been |was )?reset|next reset available/i, settled: true },
];

function classifyResetOutput(text) {
  const body = String(text || "");
  for (const p of RESET_PATTERNS) {
    if (p.re.test(body)) return p;
  }
  return { outcome: "unknown", exit: 2, re: null, settled: false };
}

function firstLine(text) {
  const line = String(text || "")
    .split("\n")
    .map((s) => s.trim())
    .find((s) => s.length > 0);
  return line ? line.slice(0, 200) : "";
}

// Why the loop may not spend the reset right now. null = go ahead.
function resetKnobOff() {
  const knob = (process.env.SHIPFLOW_LOOP_LIMIT_RESET || "").trim().toLowerCase();
  return ["off", "0", "false", "no", "never"].includes(knob) ? `disabled by SHIPFLOW_LOOP_LIMIT_RESET=${knob}` : null;
}

// The reason the last attempt still parks this one, or null. A settled
// outcome holds for a week; a transient one for an hour.
function resetCooldownReason(snapshot, now) {
  const prev = snapshot && snapshot.limit_reset;
  if (prev && typeof prev.attempted_at === "string") {
    const at = Math.floor(Date.parse(prev.attempted_at) / 1000);
    const cooldown = prev.settled ? RESET_COOLDOWN_SECONDS : RESET_RETRY_SECONDS;
    if (Number.isFinite(at) && now - at < cooldown) {
      const mins = Math.max(1, Math.round((cooldown - (now - at)) / 60));
      return `last attempt (${prev.outcome}) was ${Math.round((now - at) / 60)} min ago — next try in ${mins} min`;
    }
  }
  return null;
}

// --reset-at: the usage the blocking window must have reached before a reset
// is spent. Resolved like --max (flag → env → default); a floor under --max
// changes nothing, because below --max the verdict is never "over".
function resetFloor(opts) {
  const floor = Number(opts["reset-at"] ?? envNum(process.env.SHIPFLOW_LOOP_RESET_AT) ?? RESET_FLOOR_DEFAULT);
  if (!Number.isFinite(floor) || floor <= 0 || floor > 100) {
    process.stderr.write(`shipflow-usage: --reset-at must be a percentage in (0, 100], got ${JSON.stringify(opts["reset-at"])}\n`);
    return null;
  }
  return floor;
}

// The window that stopped the loop is over --max but still under the reset
// floor: it resets on its own, so the once-a-week reset is not spent on it.
function resetFloorReason(result, floor) {
  const w = result.worst;
  if (!w || w.used_percentage >= floor) return null;
  const at = typeof w.resets_at === "number" ? ` — it resets on its own at ${formatResetsAt(w.resets_at)}` : "";
  return `${w.label} usage ${Math.round(w.used_percentage)}% is under the reset floor ${floor}%${at}`;
}

function resetSkipReason(result, snapshot, now, floor) {
  const off = resetKnobOff();
  if (off) return off;
  if (result.verdict !== "over") {
    return result.verdict === "unknown"
      ? `usage is unknown (${result.reason}) — never spend the weekly reset on a guess`
      : `usage is below the threshold (${result.reason})`;
  }
  if (!result.worst || result.worst.window !== "five_hour") {
    const label = result.worst ? result.worst.label : "the limit";
    return `${label} is what is over, and /limit-reset only clears the 5-hour window`;
  }
  const weekly = result.windows && result.windows.seven_day;
  if (weekly && weekly.used_percentage >= result.max) {
    return `7d usage ${Math.round(weekly.used_percentage)}% ≥ ${result.max}% — the weekly limit survives a session reset`;
  }
  return resetFloorReason(result, floor) || resetCooldownReason(snapshot, now);
}

function cmdLimitReset(opts) {
  const max = Number(opts.max ?? envNum(process.env.SHIPFLOW_LOOP_USAGE_MAX) ?? 90);
  if (!Number.isFinite(max) || max <= 0 || max > 100) {
    process.stderr.write(`shipflow-usage: --max must be a percentage in (0, 100], got ${JSON.stringify(opts.max)}\n`);
    return 1;
  }
  const floor = resetFloor(opts);
  if (floor === null) return 1;
  const now = nowSeconds();
  const snapshot = readJSON(SNAPSHOT);
  const result = evaluate(snapshot, { max, maxAge: 3600, now });
  const out = { action: "limit-reset", max, reset_at: floor, outcome: "skipped", reason: "", detail: "", ran: false };

  const skip = resetSkipReason(result, snapshot, now, floor);
  if (skip) {
    out.reason = skip;
    emitReset(out, opts);
    return 5;
  }
  out.reason = result.reason;

  if (opts["dry-run"]) {
    out.outcome = "would-run";
    out.detail = `${claudeBin()} -p /limit-reset`;
    emitReset(out, opts);
    return 0;
  }

  const bin = claudeBin();
  const proc = spawnSync(bin, ["-p", "/limit-reset"], { encoding: "utf8", timeout: 180000 });
  out.ran = true;
  if (proc.error || typeof proc.stdout !== "string") {
    out.outcome = "error";
    out.detail = proc.error ? String(proc.error.message).slice(0, 200) : "no output from the claude CLI";
    recordResetAttempt(out.outcome, out.detail, false, now);
    emitReset(out, opts);
    return 2;
  }
  const body = `${proc.stdout}\n${proc.stderr || ""}`;
  const verdict = classifyResetOutput(body);
  out.outcome = verdict.outcome;
  out.detail = firstLine(body);
  recordResetAttempt(verdict.outcome, out.detail, verdict.settled, now);
  if (verdict.outcome === "reset") clearFiveHourWindow(now);
  emitReset(out, opts);
  return verdict.exit;
}

function claudeBin() {
  return process.env.SHIPFLOW_CLAUDE_BIN || "claude";
}

function emitReset(out, opts) {
  if (opts.text) {
    const status = out.outcome === "reset" ? "RESET" : out.outcome === "would-run" ? "DRY-RUN" : "NO RESET";
    process.stdout.write(`limit-reset ${status}: ${out.reason || out.detail || out.outcome}\n`);
    return;
  }
  process.stdout.write(JSON.stringify(out) + "\n");
}

function recordResetAttempt(outcome, detail, settled, now, idempotencyKey) {
  const snapshot = readJSON(SNAPSHOT) || {};
  snapshot.limit_reset = {
    attempted_at: new Date(now * 1000).toISOString(),
    outcome,
    detail,
    settled: Boolean(settled),
  };
  if (idempotencyKey) snapshot.limit_reset.idempotency_key = idempotencyKey;
  if (outcome === "reset") snapshot.limit_reset.used_at = snapshot.limit_reset.attempted_at;
  writeJSONAtomic(SNAPSHOT, snapshot);
}

// A successful reset restarts the 5-hour window, so the percentage in the
// snapshot is now wrong and would keep the gate stopped until the statusline
// next refreshes. Drop the window rather than invent a number for it, and
// stamp recorded_at because the account state was just observed.
function clearFiveHourWindow(now) {
  const snapshot = readJSON(SNAPSHOT);
  if (!snapshot) return;
  if (snapshot.windows && typeof snapshot.windows === "object") delete snapshot.windows.five_hour;
  snapshot.recorded_at = new Date(now * 1000).toISOString();
  writeJSONAtomic(SNAPSHOT, snapshot);
}

// ── codex ───────────────────────────────────────────────────────────────────

function usageSource(opts) {
  const raw = String(opts.source || process.env.SHIPFLOW_USAGE_SOURCE || "").trim().toLowerCase();
  if (raw === "codex" || raw === "claude") return raw;
  if (raw) return null;
  if (process.env.CODEX_SANDBOX || process.env.CODEX_THREAD_ID) return "codex";
  return "claude";
}

function codexBin() {
  return process.env.CODEX_BIN || "codex";
}

// One JSON-RPC exchange with `codex app-server` over stdio: initialize, then
// the request. The server answers one JSON object per line and keeps running
// until stdin closes, so stdin stays open until the reply (or the timeout) —
// closing it first makes the server exit before it answers.
function codexRpc(method, params, timeoutMs) {
  return new Promise((resolve) => {
    let child;
    try {
      child = spawn(codexBin(), ["app-server"], { stdio: ["pipe", "pipe", "pipe"] });
    } catch (err) {
      resolve({ error: `cannot run ${codexBin()} app-server: ${err && err.message}` });
      return;
    }
    let buf = "";
    let stderr = "";
    let done = false;
    let timer = null;
    const finish = (out) => {
      if (done) return;
      done = true;
      if (timer) clearTimeout(timer);
      try {
        child.kill();
      } catch {
        // already gone
      }
      resolve(out);
    };
    timer = setTimeout(() => finish({ error: `codex app-server did not answer ${method} within ${Math.round(timeoutMs / 1000)}s` }), timeoutMs);
    child.on("error", (err) => finish({ error: `cannot run ${codexBin()} app-server: ${err.message}` }));
    child.stderr.on("data", (d) => {
      stderr += String(d);
    });
    child.stdout.on("data", (d) => {
      buf += String(d);
      let nl;
      while ((nl = buf.indexOf("\n")) >= 0) {
        const line = buf.slice(0, nl).trim();
        buf = buf.slice(nl + 1);
        if (!line) continue;
        let msg;
        try {
          msg = JSON.parse(line);
        } catch {
          continue;
        }
        if (msg && msg.id === 2) {
          if (msg.error) finish({ error: `${method}: ${(msg.error && msg.error.message) || JSON.stringify(msg.error)}` });
          else finish({ result: msg.result });
        }
      }
    });
    child.on("close", (code) =>
      finish({ error: `codex app-server exited (${code}) before answering ${method}${stderr.trim() ? `: ${firstLine(stderr)}` : ""}` }),
    );
    child.stdin.on("error", () => {});
    const lines = [
      { jsonrpc: "2.0", id: 1, method: "initialize", params: { clientInfo: { name: "shipflow-usage", title: "ShipFlow usage gate", version: "1" } } },
      { jsonrpc: "2.0", method: "initialized" },
      { jsonrpc: "2.0", id: 2, method, params: params || {} },
    ];
    child.stdin.write(lines.map((l) => JSON.stringify(l)).join("\n") + "\n");
  });
}

// The app server names windows by duration, not by kind; map them onto the
// snapshot shape `evaluate` reads. `rateLimits` is the account's active limit
// (`primary` = its main window — 5h on most plans, weekly on some — and
// `secondary` the other); `rateLimitsByLimitId` adds per-model buckets with
// their own windows (measured: the account limit carried only the weekly
// window while the model bucket carried the 5-hour one). The gate fails
// closed, so every bucket counts and the WORST reading per window kind wins.
function codexWindows(result, now) {
  const out = {};
  const buckets = [result && result.rateLimits];
  const byId = result && result.rateLimitsByLimitId;
  if (byId && typeof byId === "object") for (const b of Object.values(byId)) buckets.push(b);
  for (const rl of buckets) {
    for (const w of [rl && rl.primary, rl && rl.secondary]) {
      if (!w || typeof w.usedPercent !== "number" || !Number.isFinite(w.usedPercent)) continue;
      const mins = w.windowDurationMins;
      const key = mins === 300 ? "five_hour" : mins === 10080 ? "seven_day" : typeof mins === "number" ? `${mins}m` : "window";
      if (typeof w.resetsAt === "number" && w.resetsAt <= now) continue;
      if (out[key] && out[key].used_percentage >= w.usedPercent) continue;
      out[key] = { used_percentage: w.usedPercent, resets_at: typeof w.resetsAt === "number" ? w.resetsAt : null };
    }
  }
  return out;
}

// Read the limits live and persist them as the Codex snapshot, so `show`, the
// limit-reset ledger and a later failed read have something to stand on. On a
// failed read the previous snapshot is returned with the error.
async function codexRefresh(now) {
  const prev = readJSON(SNAPSHOT) || {};
  const rpc = await codexRpc("account/rateLimits/read", {}, 20000);
  if (rpc.error) return { snapshot: readJSON(SNAPSHOT), error: rpc.error };
  const rl = rpc.result && rpc.result.rateLimits;
  const credits = rpc.result && rpc.result.rateLimitResetCredits;
  const stamp = new Date(now * 1000).toISOString();
  const windows = codexWindows(rpc.result, now);
  const snapshot = {
    recorded_at: stamp,
    observed_at: stamp,
    source: "codex-app-server",
    has_limits: Boolean(rl && (rl.primary || rl.secondary)) || Object.keys(windows).length > 0,
    windows,
    plan: rl && typeof rl.planType === "string" ? rl.planType : null,
    reset_credits: { available: credits && typeof credits.availableCount === "number" ? credits.availableCount : 0 },
  };
  if (prev.limit_reset && typeof prev.limit_reset === "object") snapshot.limit_reset = prev.limit_reset;
  writeJSONAtomic(SNAPSHOT, snapshot);
  return { snapshot, error: null };
}

async function cmdCheckCodex(opts) {
  const t = gateThresholds(opts);
  if (!t) return 1;
  const now = nowSeconds();
  const { snapshot, error } = await codexRefresh(now);
  const result = evaluate(snapshot, { max: t.max, maxAge: t.maxAge, now });
  result.source = "codex";
  if (error) {
    result.live_read_error = error;
    // A stale-and-over snapshot is still a lower bound (exit 3); anything
    // else cannot be known without the live numbers.
    if (result.verdict !== "over") {
      result.verdict = "unknown";
      result.ok = null;
      result.reason = snapshot ? `cannot read Codex limits (${error}); last seen ${formatWindows(liveWindows(snapshot.windows, now)) || "no windows"}` : `cannot read Codex limits (${error})`;
    }
  }
  return emitCheck(result, opts);
}

// Why the loop may not spend a Codex reset credit right now. null = go ahead.
function codexResetSkipReason(result, snapshot, now, floor) {
  const off = resetKnobOff();
  if (off) return off;
  if (result.verdict !== "over") {
    return result.verdict === "unknown"
      ? `usage is unknown (${result.reason}) — never spend a reset credit on a guess`
      : `usage is below the threshold (${result.reason})`;
  }
  const underFloor = resetFloorReason(result, floor);
  if (underFloor) return underFloor;
  const available = snapshot && snapshot.reset_credits ? Number(snapshot.reset_credits.available) : 0;
  if (!(available > 0)) {
    return "no rate-limit reset credit available — Codex grants them over time (they show under /usage)";
  }
  return resetCooldownReason(snapshot, now);
}

// consume outcomes → exit code + whether the outcome parks further attempts.
// `alreadyRedeemed` means THIS idempotency key already reset the windows: a
// retry of a success, so it is a success.
const CODEX_RESET_OUTCOMES = {
  reset: { outcome: "reset", exit: 0, settled: true },
  alreadyRedeemed: { outcome: "reset", exit: 0, settled: true },
  nothingToReset: { outcome: "nothing-to-reset", exit: 5, settled: false },
  noCredit: { outcome: "no-credit", exit: 5, settled: false },
};

async function cmdLimitResetCodex(opts) {
  const t = gateThresholds(opts);
  if (!t) return 1;
  const floor = resetFloor(opts);
  if (floor === null) return 1;
  const now = nowSeconds();
  const { snapshot, error } = await codexRefresh(now);
  const result = evaluate(snapshot, { max: t.max, maxAge: 3600, now });
  const out = { action: "limit-reset", source: "codex", max: t.max, reset_at: floor, outcome: "skipped", reason: "", detail: "", ran: false };
  if (error && result.verdict !== "over") {
    out.reason = `usage is unknown (cannot read Codex limits: ${error}) — never spend a reset credit on a guess`;
    emitReset(out, opts);
    return 5;
  }
  const skip = codexResetSkipReason(result, snapshot, now, floor);
  if (skip) {
    out.reason = skip;
    emitReset(out, opts);
    return 5;
  }
  out.reason = result.reason;
  // A retry of an unsettled attempt reuses its idempotency key, so a reset that
  // did land (but whose answer was lost) is never consumed twice.
  const prev = snapshot && snapshot.limit_reset;
  const key = prev && !prev.settled && typeof prev.idempotency_key === "string" ? prev.idempotency_key : crypto.randomUUID();
  if (opts["dry-run"]) {
    out.outcome = "would-run";
    out.detail = `${codexBin()} app-server → account/rateLimitResetCredit/consume`;
    emitReset(out, opts);
    return 0;
  }
  const rpc = await codexRpc("account/rateLimitResetCredit/consume", { idempotencyKey: key }, 30000);
  out.ran = true;
  if (rpc.error) {
    out.outcome = "error";
    out.detail = rpc.error;
    recordResetAttempt(out.outcome, out.detail, false, now, key);
    emitReset(out, opts);
    return 2;
  }
  const raw = rpc.result && rpc.result.outcome;
  const verdict = CODEX_RESET_OUTCOMES[raw] || { outcome: "unknown", exit: 2, settled: false };
  out.outcome = verdict.outcome;
  out.detail = `app server answered ${JSON.stringify(raw)}`;
  recordResetAttempt(verdict.outcome, out.detail, verdict.settled, now, key);
  // The windows just changed; re-read so the snapshot (and the caller's next
  // `check`) reflects the cleared account rather than the number that stopped it.
  if (verdict.outcome === "reset") await codexRefresh(now);
  emitReset(out, opts);
  return verdict.exit;
}

// ── install-statusline ──────────────────────────────────────────────────────

// The plugin cache path carries the version, so a hard-coded path breaks on
// the next plugin update. Inside the cache, install a resolver that picks the
// newest installed plugin at run time; elsewhere (a checkout) use this file.
function sinkCommand() {
  const self = fs.realpathSync(__filename);
  const marker = `${path.sep}.claude${path.sep}plugins${path.sep}cache${path.sep}renaissshipflow${path.sep}shipflow${path.sep}`;
  if (self.includes(marker)) {
    return `bash -c 'exec "$(ls -d ~/.claude/plugins/cache/renaissshipflow/shipflow/*/ 2>/dev/null | sort -V | tail -1)bin/shipflow-usage" record'`;
  }
  return `${JSON.stringify(self)} record`;
}

function cmdInstallStatusline(opts) {
  const configDir = process.env.CLAUDE_CONFIG_DIR || path.join(HOME, ".claude");
  const settingsPath = path.join(configDir, "settings.json");
  let settings = {};
  try {
    const raw = fs.readFileSync(settingsPath, "utf8");
    settings = raw.trim() ? JSON.parse(raw) : {};
  } catch (err) {
    if (!err || err.code !== "ENOENT") {
      process.stderr.write(`shipflow-usage: cannot parse ${settingsPath}: ${err && err.message}\n`);
      return 1;
    }
  }
  if (settings && typeof settings === "object" && settings.statusLine) {
    const current = typeof settings.statusLine === "object" ? settings.statusLine.command : settings.statusLine;
    if (typeof current === "string" && current.includes("shipflow-usage")) {
      process.stdout.write(`statusline sink already installed: ${current}\n`);
      return 0;
    }
    const chained = `input=$(cat); printf '%s' "$input" | ${sinkCommand()} >/dev/null; printf '%s' "$input" | ${String(current)}`;
    process.stdout.write(
      `a statusLine is already configured in ${settingsPath}:\n  ${String(current)}\n` +
        `Not touching it. Chain the sink so both run:\n` +
        `  "command": ${JSON.stringify(chained)}\n`,
    );
    return 4;
  }
  const next = Object.assign({}, settings, { statusLine: { type: "command", command: sinkCommand(), padding: 0 } });
  if (opts["dry-run"]) {
    process.stdout.write(`would write ${settingsPath}:\n${JSON.stringify(next.statusLine, null, 2)}\n`);
    return 0;
  }
  writeJSONAtomic(settingsPath, next);
  process.stdout.write(`installed statusline sink in ${settingsPath} (takes effect in the next Claude Code session):\n  ${next.statusLine.command}\n`);
  return 0;
}

// ── main ────────────────────────────────────────────────────────────────────

async function main() {
  const opts = parseArgs(process.argv.slice(2));
  const cmd = opts._[0];
  const source = usageSource(opts);
  if (source === null) {
    process.stderr.write(`shipflow-usage: --source must be codex or claude, got ${JSON.stringify(opts.source || process.env.SHIPFLOW_USAGE_SOURCE)}\n`);
    return 1;
  }
  SNAPSHOT = source === "codex" ? CODEX_SNAPSHOT : CLAUDE_SNAPSHOT;
  switch (cmd) {
    case "record":
      // The statusline sink is Claude Code's, whatever the session's source.
      SNAPSHOT = CLAUDE_SNAPSHOT;
      return cmdRecord();
    case "check":
      return source === "codex" ? cmdCheckCodex(opts) : cmdCheck(opts);
    case "install-statusline":
      if (source === "codex") {
        process.stdout.write("no statusline sink needed on Codex: shipflow-usage reads the limits live from `codex app-server` (what /usage shows)\n");
        return 0;
      }
      return cmdInstallStatusline(opts);
    case "limit-reset":
      return source === "codex" ? cmdLimitResetCodex(opts) : cmdLimitReset(opts);
    case "show": {
      const snap = readJSON(SNAPSHOT);
      process.stdout.write(snap ? JSON.stringify(snap, null, 2) + "\n" : `no snapshot at ${SNAPSHOT}\n`);
      return snap ? 0 : 2;
    }
    default:
      process.stderr.write(
        "usage: shipflow-usage record | check [--max N] [--max-age SECONDS] [--text] | " +
          "limit-reset [--max N] [--reset-at N] [--dry-run] [--text] | install-statusline [--dry-run] | show\n" +
          "       [--source codex|claude]  (default: $SHIPFLOW_USAGE_SOURCE, else codex inside a Codex shell, else claude)\n",
      );
      return 1;
  }
}

main().then((code) => {
  process.exitCode = code;
});
